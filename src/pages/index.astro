    }
    .infocus-authors a { color: var(--theme); text-decoration: none; position: relative; z-index: 2; }
    .infocus-authors a:hover { text-decoration: underline; }
    .infocus-authors .sep { color: var(--theme); }
    .infocus-sub {
      font-family: 'Antique Olive', sans-serif;
      font-weight: 300; 
      font-size: 14px;
      line-height: 1.3;
      color: var(--text);
      margin: 0 0 13px;
    }
    .infocus-foot {
      display: flex;
      justify-content: space-between;    /* date left, type right-aligned within the meta */
      gap: 40px;                         /* minimum gap between Date and Essay */
      font-family: 'Roboto', sans-serif;
      text-transform: uppercase;
      font-size: 13px;
      color: var(--text);
      margin: auto 0 0;                 /* …but push the date/essay line to the bottom */
    }

    /* ---------- Latest reports carousel ---------- */
    .reports {    /* this is the background panel behind the carousel */
      padding: 44px 0 100px; 
      background-color: var(--almost-white); 
    }

    .reports-box-wrapper { padding: 0 30px;  }
    .reports-box {
      position: relative;               /* anchors the overlaid arrows */
      border: 1.5px solid var(--border-grey);
      border-radius: 4px;
      padding: 20px 20px 18px;
      background-color: var(--bg-secondary);
    }
    .reports-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 18px;
      border: 1px solid var(--border-grey);
      border-radius: 4px; 
      padding: 8px; 
      background-color: var(--almost-white)
    }
    .reports-head .reports-head-label { margin: 0; font-family: 'Copperplate', sans-serif; font-weight: 300; margin-left: 5px; margin-top: 4px; }
    .reports-viewall {
