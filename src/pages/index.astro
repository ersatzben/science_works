    .report-authors .sep { color: var(--theme); }
    /* Date (left) and type (right, e.g. "Essay"), pinned to the bottom of the card. */

    .report-sub { font-family: 'Antique Olive', sans-serif; font-weight: 300; font-size: 12px; color: var(--text); position: relative; margin: 0 0 16px; line-height: 1.3; }
    .report-foot {
