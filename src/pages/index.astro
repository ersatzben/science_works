      display: grid;
      grid-template-columns: repeat(20, 1fr); 
      grid-template-rows: repeat(20, 1fr);
      gap: 2px;
    }
    .mg-cell { border-radius: 2px; }
    /* Slim borderless buttons holding a pixel-stepped chevron (an SVG of
       small squares, echoing the mosaic's own grout) — deliberately unlike
       the round carousel arrows, and narrow so the viewer stays compact. */
    .mg-arrow {
      width: 26px; height: 56px; flex: 0 0 auto;
      display: inline-flex; align-items: center; justify-content: center;
      padding: 0;
      color: var(--theme);
      background: none; border: none; border-radius: 4px;
      cursor: pointer;
      transition: color 0.15s ease;
    }
    .mg-arrow svg { width: 13px; height: auto; display: block; fill: currentColor; }
    .mg-arrow:hover { color: var(--darkest-brown); }

    .mg-text p {
      font-family: 'Antique Olive', sans-serif; font-weight: 300;
      font-size: 15px; line-height: 1.5; color: var(--text);
      margin: 25px 0 16px; max-width: 480px;
    }
    .mg-text p:last-child { margin-bottom: 0; }
    /* Mobile can't use the mosaic maker (it's desktop-only on /contact), so
       the submit line swaps wording below 600px. */
    .mg-submit-mobile { display: none; }
    .mg-link { color: var(--text); font-weight: 500; text-decoration: none; }
    .mg-link:hover { color: var(--theme); }

    /* Join cards: pixel icon in a pale box + one line of text, whole card clickable.
       In the three-column layout a hairline runs down the join column's left
       edge, separating the gallery half of the band from the CTAs; stretching
       the column makes the line span the full row rather than just the cards.
       Both are undone in the 1080px query, where join drops to its own row. */
    .community-join {
      display: flex; flex-direction: column;
      align-self: stretch;
      border-left: 1px solid var(--border-grey);
      padding-left: 46px;
      padding-bottom: 20px;
    }
    .cta-card {
      display: flex; align-items: center; gap: 16px;
      background: var(--almost-white);
      border: 1px solid var(--border-grey); border-radius: 3px;
      padding: 5px 8px; margin-bottom: 8px;
      text-decoration: none;
      transition: border-color 0.15s ease;
    }
    .cta-card:last-child { margin-bottom: 0; }
    .cta-card:hover { border-color: var(--theme); }
    /* GridArt (fit="contain") letterboxes itself inside the box, so the
       padding here is what sets the artwork's rendered size. */
    .cta-icon {
      flex: 0 0 auto; width: 56px; height: 56px;
      box-sizing: border-box; padding: 6px;
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--almost-white); border-radius: 4px;
    }
    .cta-text {
      font-family: 'Antique Olive', sans-serif; font-weight: 300;
      font-size: 15px; line-height: 1.4; color: var(--text);
    }
    .cta-text b { font-weight: 500; }

    /* Two rows below 1080px: gallery beside its blurb, join cards beneath.
       (1080, not 1000: between ~1001 and 1050px the three-column layout
       squeezes the text columns into aggressive wrapping, so the band drops
       to two rows before that zone is reached.) */
    @media (max-width: 1080px) {
      .community-grid { grid-template-columns: auto 1fr; gap: 40px; padding: 0 30px; }
      /* Viewer and blurb centre against each other in the two-row layout,
         so the desktop heading alignment (top + 30px drop) comes off both. */
      .mg-viewer { align-self: center; margin-top: 0; }
      .mg-text { margin-top: 0; align-self: center; }
      /* Join spans the full width, its two cards side by side; the desktop
         divider comes off, as there is no longer a column edge to sit on. */
      .community-join { margin-top: 0; grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; gap: 14px; align-self: auto; border-left: none; padding-left: 0; }
      .community-join .community-heading { flex: 1 1 100%; margin-bottom: 4px; }
      .cta-card { flex: 1 1 260px; margin-bottom: 0; }
    }
    /* Full stack below 760px: blurb, gallery, join. */
    @media (max-width: 760px) {
      .community-grid { grid-template-columns: 1fr; }
      .mg-text { order: -1; }
      .mg-viewer { justify-content: center; }
    }
    @media (max-width: 600px) {
      .community { padding: 50px 0 60px; }
      .community-grid { padding: 0 18px; }
      .mg-canvas { width: min(234px, calc(100vw - 160px)); }
      /* The mosaic maker is desktop-only, so point mobile visitors there. */
      .mg-submit-desktop { display: none; }
      .mg-submit-mobile { display: inline; }
    }

