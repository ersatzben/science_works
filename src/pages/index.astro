---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GridArt from '../components/GridArt.astro';
import { coverFor } from '../lib/covers.js';
import { scholarlyType } from '../lib/scholarly.js';
import { team } from '../lib/people.js';
import quotes from '../data/quotes.json';
import introPic from '../data/decor/home-intro.json';   // mobile intro illustration (30×22)
// Featured-project grid art (18×37), one per card.
import instDynArt from '../data/projects/institutional-dynamism.json';
import aiSciSrc from '../data/projects/ai-and-science.json';
import resEconSrc from '../data/projects/the-research-economy.json';
import softSciSrc from '../data/projects/software-for-science.json';
import britSciSrc from '../data/projects/the-story-of-british-science.json';
import { cropCols, paletteGridToBitmap } from '../lib/bitmap.js';
// CTA-card icons: Laura's spanner, megaphone, and survey mosaics (Format A JSON).
import ctaSpanner from '../data/decor/cta-spanner.json';
import ctaMegaphone from '../data/decor/cta-megaphone.json';
import ctaSurvey from '../data/decor/cta-survey.json';
// The newer four come in {cols,rows,palette,grid} format → convert to a bitmap.
const aiSciArt = paletteGridToBitmap(aiSciSrc);
const resEconArt = paletteGridToBitmap(resEconSrc);
const softSciArt = paletteGridToBitmap(softSciSrc);
const britSciArt = paletteGridToBitmap(britSciSrc);
// Mobile strips show the leftmost 8 columns of the same source art.
const instDynArtM = cropCols(instDynArt, 8);
const aiSciArtM = cropCols(aiSciArt, 8);
const resEconArtM = cropCols(resEconArt, 8);
const softSciArtM = cropCols(softSciArt, 8);
const britSciArtM = cropCols(britSciArt, 8);

// Splash hero art: one continuous freeform-painted cell field
// (src/data/splash/canvas.json — edit at /dev/canvas-editor) plus the
// runtime config for the animated overlays (src/lib/splashConfig.mjs).
// Serialised below for the inline canvas engine.
import splashCanvas from '../data/splash/canvas.json';
import { splashConfig } from '../lib/splashConfig.mjs';
// Shared visitor-mosaic palette (append-only) — used by the community band below.
import { PALETTE } from '../lib/mosaicPalette.js';
const splashScene = { canvas: splashCanvas, config: splashConfig };

// Community band (below the carousel): the visitor-mosaic gallery plus the
// join-the-community CTAs. Each gallery mosaic is one { code, name } JSON in
// src/data/gallery/ — `code` is the 400-char base-36 string the contact-page
// maker produces (one digit per cell of its 20×20 grid, indexing the shared
// palette). Filename order is display order; to feature a submission, copy the
// `mosaic_code` from its email into a new file there.
const MOSAIC_CELLS = 400;   // the maker's 20×20 grid
const galleryModules = import.meta.glob('../data/gallery/*.json', { eager: true });
const gallery = Object.keys(galleryModules).sort()
  .map((k) => galleryModules[k].default ?? galleryModules[k])
  .filter((g) => g && typeof g.code === 'string' && g.code.length === MOSAIC_CELLS);
// The first mosaic is server-rendered so the gallery isn't blank before JS runs.
const firstMosaic = gallery.length
  ? gallery[0].code.split('').map((ch) => (PALETTE[parseInt(ch, 36)] ?? PALETTE[0]).hex)
  : null;

// The Build Club sign-up page on Luma.
const BUILD_CLUB_URL = 'https://luma.com/scienceworks';

// The CTA icons (imported up top) render as inline SVG via <GridArt>. Both
// were drawn on the full 20×20 maker grid, leaving a transparent margin;
// trimGrid crops empty outer rows/columns at build time so the artwork
// centres in its box — the JSON files stay exactly as authored.
const trimGrid = ({ cols, rows, palette, grid }) => {
  let top = 0, bottom = rows - 1, left = 0, right = cols - 1;
  while (top < bottom && grid[top].every((v) => v < 0)) top++;
  while (bottom > top && grid[bottom].every((v) => v < 0)) bottom--;
  const colEmpty = (c) => grid.slice(top, bottom + 1).every((row) => row[c] < 0);
  while (left < right && colEmpty(left)) left++;
  while (right > left && colEmpty(right)) right--;
  const sub = grid.slice(top, bottom + 1).map((row) => row.slice(left, right + 1));
  return { cols: right - left + 1, rows: bottom - top + 1, palette, grid: sub };
};
const ctaSpannerArt = paletteGridToBitmap(trimGrid(ctaSpanner));
const ctaMegaphoneArt = paletteGridToBitmap(trimGrid(ctaMegaphone));
const ctaSurveyArt = paletteGridToBitmap(trimGrid(ctaSurvey));

// In Focus + carousel are driven by the writing collection (same source as /writing).
const all = (await getCollection('writing'))
  .filter((e) => !e.data.draft && !e.data.hidden)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = all.find((e) => e.data.featured) ?? all[0];
const fmt = (d) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const typeLabel = (t) => scholarlyType(t).label;
const ifCover = coverFor(featured);

// Spotlight footer: a 4x4 pixel motif above each section title.
// Legend → palette: fills (0 = transparent), border-only letters, and X (fill + border).
const sifFill = {
  '1': 'var(--theme)', '2': 'var(--coral)', '3': 'var(--bright-blue)',
  '4': 'var(--pale-blue)', '5': 'var(--deep-green)', '6': 'var(--sage)',
  '7': 'var(--text)', '8': 'var(--darkest-brown)', '9': 'var(--opt-2)',
  'G': 'var(--light-green)',
};
const sifBorder = {
  'A': 'var(--theme)', 'B': 'var(--bright-blue)', 'C': 'var(--deep-green)',
  'D': 'var(--sage)', 'E': 'var(--text)', 'F': 'var(--light-green)',
};
const sifCellStyle = (ch) => {
  if (ch === 'X') return 'background: var(--darkest-brown); border-color: var(--pale-blue);';
  if (sifFill[ch]) return `background: ${sifFill[ch]};`;
  if (sifBorder[ch]) return `border-color: ${sifBorder[ch]};`;
  return '';   // '0' → transparent
};
const sifItems = [
  { label: 'Writing',      art: ['0000', '0000', '0200', '1A00'] },
  { label: 'Analytics',    art: ['0000', '0000', '4B00', '3340'] },
  { label: 'Tool-building', art: ['0000', '0C00', '0500', 'FG55'] },
  { label: 'Community',    art: ['0070', '0470', '0XE4', 'E87E'] },
];

// Homepage structured data (schema.org), emitted as a @graph so the nodes are
// cross-linked by @id:
//   • WebSite  — tells Google the site name is "Science Works" (not the bare
//                "science.works" domain) for the site-name feature in SERPs.
//   • Organization — feeds Google's knowledge panel. `@id` is stable
//                (/#organization) so Person `worksFor` on profile pages binds to
//                this same entity; `member` links the org to each team profile.
const homeURL = new URL('/', Astro.site).href;
const orgId = new URL('/#organization', Astro.site).href;
const siteId = new URL('/#website', Astro.site).href;
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': siteId,
      url: homeURL,
      name: 'Science Works',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'Science Works',
      url: homeURL,
      logo: new URL('/icon-512.png', Astro.site).href,
      description: 'Science Works is an independent research and policy studio tackling the biggest problems facing UK science and technology.',
      sameAs: [
        'https://x.com/sci_works',
        'https://bsky.app/profile/science.works',
      ],
      member: team.map((p) => ({
        '@type': 'Person',
        '@id': `${new URL(p.path, Astro.site).href}#person`,
        name: p.name,
        jobTitle: p.role,
        url: new URL(p.path, Astro.site).href,
      })),
    },
  ],
};
---
<BaseLayout title="Science Works — Reshaping British Science and Technology">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(orgJsonLd)} />
  <section id="splash">
    <div class="stage">
      <canvas id="splash-canvas" role="img" aria-label="Pixel-mosaic landscape of British science: a DNA helix, microchip, punch card, laboratory glassware, the map of Great Britain, a grand scientific institution, rising charts, a lightbulb, and people standing before a Victorian viaduct crossed by a steam train"></canvas>
      <div class="hero-box">
        <h1 class="hero-title"><strong>Reshaping British</strong> Science & Technology</h1>
        <div class="hero-rule" aria-hidden="true"></div>
        <p class="hero-tag">Better policy. Better software. Better research</p>
      </div>
    </div>
    <div class="mobile-hero">
      <div class="mhero-hero">
        <h1 class="mhero-title">Reshaping<br>British<br>Science and<br>Technology</h1>
        <p class="mhero-blurb">Science Works is an independent research and policy studio aiming to tackle the biggest problems facing UK science and technology.</p>
        <div class="mhero-rule"></div>
        <div class="mhero-actions">
          <a class="mhero-btn mhero-btn--primary" href="/writing">Explore Our Work</a>
          <a class="mhero-btn mhero-btn--secondary" href="/about">About Us</a>
        </div>
      </div>
    </div>
  </section>



  <!-- 2. Spotlight: pinned intro (left) + scrolling featured projects (right) -->
  <section class="spotlight" id="projects">
    <div class="content-wrap spotlight-grid">
      <div class="spotlight-intro">
        <div class="intro-matrix" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
        <div class="intro-pic" style={`--ip-cols:${introPic.cols}`} aria-hidden="true">
          {introPic.grid.flat().map((v) => (<span class="intro-pic-cell" style={v >= 0 ? `background:${introPic.palette[v]}` : ''}></span>))}
        </div>
        <p class="intro-eyebrow">Science Works</p>
        <h2>Britain needs a metascientific revolution</h2>
        <p>The UK is fundamentally a scientific nation. Our place in the world has long been underwritten by the creativity of our laboratories, workshops, and universities.</p>
        <p>Today, our imagination is running into the limits of an overstretched system built for another era.</p><p>We&rsquo;ve lost much of the freedom that once defined British science, and failed to seize the possibilities of our technological age. This is what animates us at Science Works.</p>
        <a class="hero-link" href="/writing">Explore Our Work  &rarr;</a>
        <div class="spotlight-intro-footer">
          {sifItems.map((it) => (
            <div class="sif-item">
              <div class="sif-art" aria-hidden="true">
                {it.art.map((row) => row.split('').map((ch) => (
                  <span class="sif-cell" style={sifCellStyle(ch)}></span>
                )))}
              </div>
              <div class="sif-label">{it.label}</div>
            </div>
          ))}
        </div>
      </div>


      <div class="spotlight-main">
        <canvas class="spotlight-rain" aria-hidden="true"></canvas>
        <h2 class="section-label">featured projects<span class="scroll-cue" aria-hidden="true">scroll<span class="scroll-cue-arrow">&rarr;</span></span></h2>
        <div class="projects">
        <article class="project">
          <div class="project-body">
            <h3 class="project-title">Institutional Dynamism</h3>
            <div class="project-detail">
              <p class="project-sub">What mix of research institutions does Britain need, and how could we build them?</p>
              <p class="project-text">Different kinds of scientific and technological projects need different types of support, and different homes.</p>
              <p class="project-text">Britain&rsquo;s institutional repertoire and funding architecture are narrower than the science we want to do.</p>
            </div>
            <a class="project-more" href="/projects#institutional-dynamism">More from this project &rarr;</a>
          </div>
          <div class="project-divider" aria-hidden="true"></div>
          <div class="project-img" aria-hidden="true"><GridArt bitmap={instDynArt} fit="width" class="project-img-art project-img-art--wide" /><GridArt bitmap={instDynArtM} fit="width" class="project-img-art project-img-art--narrow" /></div>
        </article>
        <article class="project">
          <div class="project-body">
            <h3 class="project-title">AI and Science</h3>
            <div class="project-detail">
              <p class="project-sub">How should British science adapt to the coming AI revolution?</p>
              <p class="project-text">Artificial intelligence will expand our horizons, and change what it means to be a scientist.</p>
              <p class="project-text">We must ensure that we reap the benefits of AI-assisted discovery without compounding existing dysfunctions.</p>
            </div>
            <a class="project-more" href="/projects#ai-and-science">More from this project &rarr;</a>
          </div>
          <div class="project-divider" aria-hidden="true"></div>
          <div class="project-img" aria-hidden="true"><GridArt bitmap={aiSciArt} fit="width" class="project-img-art project-img-art--wide" /><GridArt bitmap={aiSciArtM} fit="width" class="project-img-art project-img-art--narrow" /></div>
        </article>
        <article class="project">
          <div class="project-body">
            <h3 class="project-title">The Research Economy</h3>
            <div class="project-detail">
              <p class="project-sub">How does Britain&rsquo;s research and innovation economy really work &ndash; and can it be made more dynamic?</p>
              <p class="project-text">The UK invests huge sums in R&D without fully understanding how the system works as a whole.</p>
              <p class="project-text">Crude metrics obscure its true nature, while incentives, frictions, and hidden cross-subsidies shape decisions on the ground.</p>
            </div>
            <a class="project-more" href="/projects#the-research-economy">More from this project &rarr;</a>
          </div>
          <div class="project-divider" aria-hidden="true"></div>
          <div class="project-img" aria-hidden="true"><GridArt bitmap={resEconArt} fit="width" class="project-img-art project-img-art--wide" /><GridArt bitmap={resEconArtM} fit="width" class="project-img-art project-img-art--narrow" /></div>
        </article>
        <article class="project">
          <div class="project-body">
            <h3 class="project-title">Software for Science</h3>
            <div class="project-detail">
              <p class="project-sub">Why does public research still run on poor software &ndash; and what could great tools unlock?</p>
              <p class="project-text">Modern research increasingly depends on the digital.</p>
              <p class="project-text">But tooling is underrecognised as a research output, with neither the infrastructure to share and maintain tools nor the incentives to do so.</p>
            </div>
            <a class="project-more" href="/projects#software-for-science">More from this project &rarr;</a>
          </div>
          <div class="project-divider" aria-hidden="true"></div>
          <div class="project-img" aria-hidden="true"><GridArt bitmap={softSciArt} fit="width" class="project-img-art project-img-art--wide" /><GridArt bitmap={softSciArtM} fit="width" class="project-img-art project-img-art--narrow" /></div>
        </article>
        <article class="project">
          <div class="project-body">
            <h3 class="project-title">A Story of British Science</h3>
            <div class="project-detail">
              <p class="project-sub">How can we tell a story of British scientific renewal &ndash; linking institutions, place, and purpose?</p>
              <p class="project-text">Few things matter more to our future prosperity than our capacity for discovery and invention.</p>
              <p class="project-text">We need a vision (and a strategy) for the next decade of British science that is ambitious, tangible, and beautiful. </p>
            </div>
            <a class="project-more" href="/projects#a-story-of-british-science">More from this project &rarr;</a>
          </div>
          <div class="project-divider" aria-hidden="true"></div>
          <div class="project-img" aria-hidden="true"><GridArt bitmap={britSciArt} fit="width" class="project-img-art project-img-art--wide" /><GridArt bitmap={britSciArtM} fit="width" class="project-img-art project-img-art--narrow" /></div>
        </article>
        </div>
      </div>
    </div>
  </section>
  <div class="content-wrap-lower">
    <!-- 3. In Focus: one highlighted publication -->
    <section class="infocus">
      <div class="content-wrap">
      <div class="infocus-row">
        <div class="infocus-card">
          <a class="infocus-link" href={`/writing/${featured.id}`} aria-label={featured.data.title}></a>
          <div class="infocus-art" id="infocus-art" aria-hidden="true">{ifCover && <GridArt bitmap={ifCover} />}</div>
          <div class="infocus-meta">
            <p class="infocus-tag">In Focus</p>
            <h3 class="infocus-title">{featured.data.title}</h3>
            <p class="infocus-authors">{featured.data.authors.join(', ')}</p>
            {(featured.data.summary ?? featured.data.subtitle) && <p class="infocus-sub">{featured.data.summary ?? featured.data.subtitle}</p>}
            <p class="infocus-foot"><span class="infocus-date">{fmt(featured.data.date)}</span><span class="infocus-type">{typeLabel(featured.data.type)}</span></p>
          </div>
        </div>

        <figure class="quote-box">
          <div class="quote-top">
            <span class="quote-mark" aria-hidden="true">&ldquo;</span>
            <span class="quote-rule" aria-hidden="true"></span>
          </div>
          <div class="quote-content">
            <blockquote class="quote-text">{(Array.isArray(quotes[0].text) ? quotes[0].text : [quotes[0].text]).map((p) => <p class="quote-para">{p}</p>)}</blockquote>
            <figcaption class="quote-author">{quotes[0].author}</figcaption>
          </div>
        </figure>
      </div>
      </div>
    </section>

    <script define:vars={{ IF_COLS: ifCover?.cols ?? 1, IF_ROWS: ifCover?.rows ?? 1, IF_SIZE: ifCover?.cell?.size ?? 14, IF_GAP: ifCover?.cell?.gap ?? 2 }}>
      (function () {
        // Fill the In Focus card height with WHOLE cells: keep all rows, scale so
        // they fill the box height, then show however many whole columns fit the
        // width (centre-cropped). Re-runs as the card grows/shrinks with the quote.
        var box = document.getElementById('infocus-art');
        if (!box) return;
        var svg = box.querySelector('svg');
        if (!svg) return;
        var pitch = IF_SIZE + IF_GAP;
        var hNat = IF_ROWS * pitch - IF_GAP;          // native height of all rows
        function render() {
          var W = box.clientWidth, H = box.clientHeight;
          if (!W || !H) return;
          var scale = H / hNat;                        // all rows fill the height
          var visCols = Math.floor((W / scale + IF_GAP) / pitch);   // whole columns that fit the width
          visCols = Math.max(1, Math.min(IF_COLS, visCols));
          var startCol = Math.floor((IF_COLS - visCols) / 2);
          var vbW = visCols * pitch - IF_GAP;
          svg.setAttribute('viewBox', (startCol * pitch) + ' 0 ' + vbW + ' ' + hNat);
          svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
          svg.style.width = (vbW * scale) + 'px';
          svg.style.height = H + 'px';
          svg.style.margin = '0 auto';                 // centre the column window
        }
        if (window.ResizeObserver) new ResizeObserver(render).observe(box);
        else window.addEventListener('resize', render);
        render();
      })();
    </script>

    <script define:vars={{ swQuotes: quotes, ROTATE_MS: 12000 }}>
      (function () {
        if (!Array.isArray(swQuotes) || swQuotes.length === 0) return;
        var content = document.querySelector('.quote-content');
        var textEl = document.querySelector('.quote-text');
        var authorEl = document.querySelector('.quote-author');
        if (!content || !textEl || !authorEl) return;
        function shuffle(arr) {
          var a = arr.slice();
          for (var k = a.length - 1; k > 0; k--) {     // Fisher–Yates
            var j = (Math.random() * (k + 1)) | 0;
            var t = a[k]; a[k] = a[j]; a[j] = t;
          }
          return a;
        }
        function renderText(text) {
          var paras = Array.isArray(text) ? text : [text];
          textEl.innerHTML = '';
          paras.forEach(function (p) {
            var pe = document.createElement('p');
            pe.className = 'quote-para';
            pe.textContent = p;
            textEl.appendChild(pe);
          });
        }
        function show(q) {
          renderText(q.text);
          authorEl.textContent = q.author;
        }
        // Randomise the rotation order on each load. The first item replaces the
        // server-rendered quotes[0] so visitors don't always open on the same one.
        var order = shuffle(swQuotes), i = 0;
        if (order[0] !== swQuotes[0]) show(order[0]);
        if (swQuotes.length < 2) return;   // single quote → static
        var FADE = 450;
        setInterval(function () {
          i++;
          if (i >= order.length) {                     // reshuffle each full cycle…
            var last = order[order.length - 1];
            do { order = shuffle(swQuotes); } while (order[0] === last);   // …avoiding a back-to-back repeat
            i = 0;
          }
          content.style.opacity = '0';
          setTimeout(function () {
            show(order[i]);
            content.style.opacity = '1';
          }, FADE);
        }, ROTATE_MS);
      })();
    </script>

    <!-- 4. Latest reports carousel -->
    <section class="reports">
      <div class="content-wrap">
        
        <div class="reports-box-wrapper">
          
          <div class="reports-box">
            <div class="reports-head">
            <h2 class="reports-head-label">Latest from Science Works</h2>
            <a class="reports-viewall" href="/writing">View all &rarr;</a>
          </div>
            <div class="carousel-track">
              {all.map((e) => (
                <div class="report-card">
                  <a class="report-card-link" href={`/writing/${e.id}`} aria-label={e.data.title}></a>
                  {coverFor(e)
                    ? <div class="report-card-art" aria-hidden="true"><GridArt bitmap={coverFor(e)} aspect={12 / 12} /></div>
                    : <div class="report-card-pix" aria-hidden="true"></div>}
                  <div class="report-card-body">
                    <h3 class="report-title">{e.data.shortTitle ?? e.data.title}</h3>
                    <p class="report-authors">{e.data.authors.join(', ')}</p>
                    {(e.data.shortSubtitle ?? e.data.subtitle) && <p class="report-sub">{e.data.shortSubtitle ?? e.data.subtitle}</p>}
                    <p class="report-foot"><span class="report-date">{fmt(e.data.date)}</span><span class="report-type">{typeLabel(e.data.type)}</span></p>
                  </div>
                </div>
              ))}
            </div>
          <div class="carousel-arrows">
            <button class="carousel-arrow" data-dir="-1" type="button" aria-label="Previous reports">&#8249;</button>
            <button class="carousel-arrow" data-dir="1" type="button" aria-label="Next reports">&#8250;</button>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- 5. Community band: visitor-mosaic gallery + join-the-community CTAs -->
    <section class="community">
      <div class="content-wrap">
        <div class="community-grid">

          <div class="mg-viewer">
            <button class="mg-arrow" id="mg-prev" type="button" aria-label="Previous mosaic">
              <svg viewBox="0 0 38 68" aria-hidden="true"><rect x="30" y="0" width="8" height="8" rx="1.5" /><rect x="20" y="10" width="8" height="8" rx="1.5" /><rect x="10" y="20" width="8" height="8" rx="1.5" /><rect x="0" y="30" width="8" height="8" rx="1.5" /><rect x="10" y="40" width="8" height="8" rx="1.5" /><rect x="20" y="50" width="8" height="8" rx="1.5" /><rect x="30" y="60" width="8" height="8" rx="1.5" /></svg>
            </button>
            <div class="mg-frame">
              <div class="mg-canvas" id="mg-canvas" role="img" aria-label="Visitor-submitted mosaic">
                {firstMosaic && firstMosaic.map((hex) => <span class="mg-cell" style={`background:${hex}`}></span>)}
              </div>
            </div>
            <button class="mg-arrow" id="mg-next" type="button" aria-label="Next mosaic">
              <svg viewBox="0 0 38 68" aria-hidden="true"><rect x="0" y="0" width="8" height="8" rx="1.5" /><rect x="10" y="10" width="8" height="8" rx="1.5" /><rect x="20" y="20" width="8" height="8" rx="1.5" /><rect x="30" y="30" width="8" height="8" rx="1.5" /><rect x="20" y="40" width="8" height="8" rx="1.5" /><rect x="10" y="50" width="8" height="8" rx="1.5" /><rect x="0" y="60" width="8" height="8" rx="1.5" /></svg>
            </button>
          </div>
