<script type="application/json" id="splash-scene-data" is:inline set:html={JSON.stringify(splashScene)}></script>
<script is:inline>
    // ----- Legacy pixel-art source --------------------------------------
    // The desktop hero no longer uses this; it remains ONLY because the
    // (separate, unchanged) mobile hero reads window.SW.ART_PALETTE and
    // window.SW.loadArt to paint its 12×11 blocks from splash.json.
    (function () {
      const ART_PALETTE = [
        '#f6f0ed', '#66223b', '#eb3131', '#00726b', '#004ee6',
        '#a3c0d7', '#64b37b', '#0e676a', '#f45e57', '#ebe5cf',
        '#faf8f6', '#4b5cce', '#440214', '#3a3c7c', '#72679b',
      ];
      const ART_STORAGE_KEY = 'sw.pixelart.v1';
      const ART_FILE_URL = '/assets/pixel_art/splash.json';
      function loadArtLocal() {
        try {
          const raw = localStorage.getItem(ART_STORAGE_KEY);
          return raw ? JSON.parse(raw) : null;
        } catch (_) { return null; }
      }
      async function loadArtFile() {
        try {
          const resp = await fetch(ART_FILE_URL, { cache: 'no-cache' });
          if (!resp.ok) return null;
          return await resp.json();
        } catch (_) { return null; }
      }
      async function loadArt() { return loadArtLocal() || await loadArtFile(); }
      window.SW = { ART_PALETTE, loadArt, loadArtLocal, loadArtFile };
    })();

    // ----- Desktop splash: freeform-canvas mosaic engine ------------------
    // One canvas, one logical cell grid. The artwork is a single freeform
    // painted layer (canvas.json). Runtime layers on top of it:
    //   dyn     — procedural DNA helix + chart data lines
    //   overlay — the steam train
    // Figures are discovered at boot by connected-component analysis of
    // the artwork (no sprite metadata): components ≥ FIGURE_MIN cells get
    // the staggered flood reveal, click-scatter and pointer cursor; tiny
    // components (confetti) join the background sweep and twinkle pool.
    (function () {
      const canvas = document.getElementById('splash-canvas');
      const stage = document.querySelector('#splash .stage');
      const dataTag = document.getElementById('splash-scene-data');
      if (!canvas || !stage || !dataTag) return;
      let DATA = null;
      try { DATA = JSON.parse(dataTag.textContent || 'null'); } catch (_) {}
      if (!DATA || !DATA.canvas || !DATA.config) return;
      const ART = DATA.canvas, CFG = DATA.config;

      const COLS = ART.cols, ROWS = ART.rows, N = COLS * ROWS;
      const CELL_FRAC = 12 / 14;   // cell square vs pitch (12px on a 14px pitch)
      const FIGURE_MIN = 30;       // component size that counts as a "figure"
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let reduced = reduceMotion.matches;

      // --- deterministic RNG for reveal jitter/shuffle -------------------
      function mulberry32(a) {
        return function () {
          a = (a + 0x6d2b79f5) | 0;
          let t = Math.imul(a ^ (a >>> 15), 1 | a);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }
      function hashStr(s) {
        let h = 2166136261;
        for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);
        return h >>> 0;
      }
      const rng = mulberry32(hashStr('science-works-splash-runtime'));

      // --- colours as 24-bit ints; -1 = transparent ----------------------
      const hex2int = (h) => parseInt(h.slice(1), 16);
      const cssCache = new Map();
      function css(v) {
        let s = cssCache.get(v);
        if (!s) { s = '#' + v.toString(16).padStart(6, '0'); cssCache.set(v, s); }
        return s;
      }
      function mix(a, b, t) {
        const ar = (a >> 16) & 255, ag = (a >> 8) & 255, ab = a & 255;
        const br = (b >> 16) & 255, bg = (b >> 8) & 255, bb = b & 255;
        return (((ar + (br - ar) * t) | 0) << 16) | (((ag + (bg - ag) * t) | 0) << 8) | ((ab + (bb - ab) * t) | 0);
      }
      const THEME = hex2int(CFG.theme);
      const WHITE = 0xffffff;
      const BASE_TILE = hex2int(CFG.baseTile || '#fffbf7');

      // --- layers ----------------------------------------------------------
      const idxOf = (x, y) => y * COLS + x;
      const inGrid = (x, y) => x >= 0 && x < COLS && y >= 0 && y < ROWS;
      const pal = ART.palette.map(hex2int);
      const cells = new Int32Array(N).fill(-1);      // the painted artwork
      for (let i = 0; i < N; i++) {
        const v = ART.cells[i];
        if (v >= 0) cells[i] = pal[v];
      }
      // The hero text (.hero-box) sits over the canvas with a fully
      // transparent background — space for it is painted into the artwork
      // itself, so the engine gives it no special treatment. (Its footprint
      // lives in splashConfig.plaque purely as a guide for the editor.)
      const dyn = new Int32Array(N).fill(-1);        // DNA + chart lines
      const overlay = new Int32Array(N).fill(-1);    // train + steam
      const shown = new Uint8Array(N);               // reveal gate
      const twinkles = new Map();                    // idx → brightness boost
      const dirty = new Set();

      // --- connected components: figures emerge from the artwork ---------
      // Only "solid" cells participate: faint cream texture (near the
      // stage background colour) is background — otherwise a chain of
      // texture specks would weld figures together into one giant
      // component and merge their reveal/scatter.
      const BG_INT = 0xf6f0ed;   // the stage/grout colour (--bg)
      // Calm background tones: the almost-white default tile and the faint
      // cream texture both sit close to the grout colour. They're excluded
      // from figure components (so texture can't weld figures together) and
      // revealed instantly (so only the colourful bits animate in).
      function colorDist2(v, ref) {
        const dr = ((v >> 16) & 255) - ((ref >> 16) & 255);
        const dg = ((v >> 8) & 255) - ((ref >> 8) & 255);
        const db = (v & 255) - (ref & 255);
        return dr * dr + dg * dg + db * db;
      }
      function nearBg(v) {
        if (v < 0) return true;
        return colorDist2(v, BG_INT) < 32 * 32;
      }
      // Stricter test for the load: only the base tile itself (and empty
      // cells) may appear instantly. Everything with any visible tint —
      // including the faint cream texture, which reads as grey speckle
      // against the almost-white field — animates in with the sweep.
      function isCalm(v) {
        if (v < 0) return true;
        return colorDist2(v, BASE_TILE) < 16 * 16;
      }
      function isSolid(i) {
        const v = cells[i];
        return v >= 0 && !nearBg(v);
      }
      const compId = new Int32Array(N).fill(-1);
      const comps = [];
      {
        const stack = [];
        for (let start = 0; start < N; start++) {
          if (!isSolid(start) || compId[start] >= 0) continue;
          const id = comps.length;
          const list = [];
          stack.push(start);
          compId[start] = id;
          while (stack.length) {
            const i = stack.pop();
            list.push(i);
            const x = i % COLS, y = (i / COLS) | 0;
            for (let dy = -1; dy <= 1; dy++) {
              for (let dx = -1; dx <= 1; dx++) {
                if (!dx && !dy) continue;
                const nx = x + dx, ny = y + dy;
                if (!inGrid(nx, ny)) continue;
                const ni = idxOf(nx, ny);
                if (compId[ni] < 0 && isSolid(ni)) { compId[ni] = id; stack.push(ni); }
              }
            }
          }
          let sx = 0, sy = 0;
          for (const i of list) { sx += i % COLS; sy += (i / COLS) | 0; }
          comps.push({ id, cells: list, size: list.length, cx: sx / list.length, cy: sy / list.length, busy: false });
        }
      }
      const figures = comps.filter((c) => c.size >= FIGURE_MIN);
      // Twinkle pool: tiny saturated specks (confetti), not cream texture.
      const twinklePool = [];
      for (const c of comps) {
        if (c.size > 2) continue;
        for (const i of c.cells) {
          const v = cells[i];
          const r = (v >> 16) & 255, g = (v >> 8) & 255, b = v & 255;
          if (Math.max(r, g, b) - Math.min(r, g, b) > 45) twinklePool.push(i);
        }
      }

      // --- geometry + painting --------------------------------------------
      const ctx = canvas.getContext('2d');
      let pw = 0, ph = 0, cs = 0, rad = 0;
      function layout() {
        const r = stage.getBoundingClientRect();
        if (r.width < 2) return false;
        const dpr = Math.min(2.5, window.devicePixelRatio || 1);
        canvas.width = Math.round(r.width * dpr);
        canvas.height = Math.round(r.height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        pw = r.width / COLS;
        ph = r.height / ROWS;
        cs = Math.min(pw, ph) * CELL_FRAC;
        rad = cs / 6;
        repaintAll();
        return true;
      }
      function cellRect(i) {
        const x = i % COLS, y = (i / COLS) | 0;
        return [x * pw + (pw - cs) / 2, y * ph + (ph - cs) / 2];
      }
      function paint(i) {
        const x = i % COLS, y = (i / COLS) | 0;
        ctx.clearRect(x * pw, y * ph, pw, ph);
        let c = -1;
        if (overlay[i] >= 0) c = overlay[i];
        else if (shown[i]) {
          c = dyn[i] >= 0 ? dyn[i] : cells[i];
          if (c >= 0 && dyn[i] < 0) {
            const tw = twinkles.get(i);
            if (tw) c = mix(c, WHITE, tw);
          }
        } else if (cells[i] >= 0) {
          // Not yet revealed (or mid-scatter): show the calm base tile
          // instead of a grout-coloured hole, so the field always reads
          // as a complete mosaic and figures materialise over it.
          c = BASE_TILE;
        }
        if (c < 0) return;
        const [px, py] = cellRect(i);
        ctx.beginPath();
        if (ctx.roundRect) ctx.roundRect(px, py, cs, cs, rad);
        else ctx.rect(px, py, cs, cs);
        ctx.fillStyle = css(c);
        ctx.fill();
      }
      function repaintAll() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (let i = 0; i < N; i++) paint(i);
        dirty.clear();
      }

      // --- virtual clock (pauses with the tab; no catch-up bursts) --------
      let vnow = 0, lastTs = -1;

      // --- reveal event queue ----------------------------------------------
      // {t, i, kind}: 0/1 = show cell, 2 = hide cell
      let events = [];
      let evCursor = 0;
      function pushEvents(list) {
        events = events.slice(evCursor).concat(list);
        events.sort((a, b) => a.t - b.t);
        evCursor = 0;
      }
      function floodOrder(cellList, seedX, seedY, jitter) {
        return cellList
          .map((i) => {
            const x = i % COLS, y = (i / COLS) | 0;
            return { i, d: Math.hypot(x - seedX, y - seedY) + rng() * jitter };
          })
          .sort((a, b) => a.d - b.d)
          .map((o) => o.i);
      }
      let revealDone = 0;
      const DNA = CFG.dna;
      function buildReveal() {
        const list = [];
        const inFigure = new Uint8Array(N);
        for (const f of figures) for (const i of f.cells) inFigure[i] = 1;
        // Pale cells enclosed by a figure (the chart's white interior, the
        // flask's glass) reveal WITH that figure, not before it — otherwise
        // they'd float there from t=0. Assign each painted non-figure cell
        // inside a figure's bounding box to the smallest such box.
        const boxes = figures.map((f) => {
          let x0 = COLS, y0 = ROWS, x1 = -1, y1 = -1;
          for (const i of f.cells) {
            const x = i % COLS, y = (i / COLS) | 0;
            if (x < x0) x0 = x; if (x > x1) x1 = x;
            if (y < y0) y0 = y; if (y > y1) y1 = y;
          }
          return { x0, y0, x1, y1, area: (x1 - x0 + 1) * (y1 - y0 + 1), extra: [] };
        });
        // Association reaches REACH cells past each bounding box, so art
        // painted just beside a figure (soft edges, halos, the odd strip
        // between two figures) reveals with the nearest figure instead of
        // sweeping in early on its own.
        const REACH = 4;
        for (let i = 0; i < N; i++) {
          if (inFigure[i] || cells[i] < 0) continue;
          const x = i % COLS, y = (i / COLS) | 0;
          let best = null;
          for (const b of boxes) {
            if (x >= b.x0 - REACH && x <= b.x1 + REACH && y >= b.y0 - REACH && y <= b.y1 + REACH && (!best || b.area < best.area)) best = b;
          }
          if (best) { best.extra.push(i); inFigure[i] = 1; }
        }
        // Background: the calm field (empty cells + the almost-white
        // default tile + faint cream texture) is shown instantly so the
        // page lands on a settled surface; only the colourful background
        // (confetti, speckle) sweeps in as a diagonal wave, then figures
        // flood on top.
        for (let i = 0; i < N; i++) {
          if (inFigure[i]) continue;
          const x = i % COLS, y = (i / COLS) | 0;
          if (isCalm(cells[i])) { shown[i] = 1; continue; }
          list.push({ t: 40 + (x + y) * 2.8 + rng() * 80, i, kind: 0 });
        }
        // Figures flood in, staggered. Oversized components — figures the
        // artwork happens to join into one connected blob (e.g. touching
        // buildings along the ground line) — are split into spatial
        // clusters via farthest-point seeding, so each part gets its own
        // quick flood and stagger slot instead of one slow mega-fill.
        // (Scatter still treats the blob as one component.)
        function splitForReveal(cellList) {
          const TARGET = 350;
          const k = Math.min(6, Math.max(1, Math.round(cellList.length / TARGET)));
          if (k <= 1) return [cellList];
          const xs = cellList.map((i) => i % COLS);
          const ys = cellList.map((i) => (i / COLS) | 0);
          const seeds = [0];
          const minD = new Float32Array(cellList.length).fill(Infinity);
          while (seeds.length < k) {
            const s = seeds[seeds.length - 1];
            let far = 0, farD = -1;
            for (let j = 0; j < cellList.length; j++) {
              const d = Math.min(minD[j], Math.hypot(xs[j] - xs[s], ys[j] - ys[s]));
              minD[j] = d;
              if (d > farD) { farD = d; far = j; }
            }
            seeds.push(far);
          }
          const clusters = seeds.map(() => []);
          for (let j = 0; j < cellList.length; j++) {
            let best = 0, bd = Infinity;
            for (let s = 0; s < seeds.length; s++) {
              const d = Math.hypot(xs[j] - xs[seeds[s]], ys[j] - ys[seeds[s]]);
              if (d < bd) { bd = d; best = s; }
            }
            clusters[best].push(cellList[j]);
          }
          return clusters.filter((c) => c.length);
        }
        // The DNA is procedural, so instead of flooding a rectangle it
        // draws itself top-to-bottom (see renderDna) starting at its own
        // slot in the stagger; its backdrop cells follow the normal
        // background rules above.
        const order = [];
        figures.forEach((f, k) => {
          for (const cl of splitForReveal(f.cells.concat(boxes[k].extra))) {
            let sx = 0, sy = 0;
            for (const i of cl) { sx += i % COLS; sy += (i / COLS) | 0; }
            order.push({ cells: cl, cx: sx / cl.length, cy: sy / cl.length });
          }
        });
        for (let k = order.length - 1; k > 0; k--) {
          const j = (rng() * (k + 1)) | 0;
          [order[k], order[j]] = [order[j], order[k]];
        }
        order.forEach((f, k) => {
          const start = 250 + k * 65;
          const flood = floodOrder(f.cells, f.cx, f.cy, 3);
          const dur = 300 + flood.length * 0.7;
          flood.forEach((i, r) => list.push({ t: start + (r / flood.length) * dur, i, kind: 1 }));
          revealDone = Math.max(revealDone, start + dur);
        });
        dnaStart = 250 + ((rng() * (order.length + 1)) | 0) * 65;
        revealDone = Math.max(revealDone, dnaStart + DNA_DRAW_MS);
        pushEvents(list);
        revealDone = Math.max(revealDone, 1400);
      }
      function processEvents() {
        while (evCursor < events.length && events[evCursor].t <= vnow) {
          const e = events[evCursor++];
          shown[e.i] = e.kind === 2 ? 0 : 1;
          dirty.add(e.i);
        }
      }
      function showEverything() {
        shown.fill(1);
        events = []; evCursor = 0;
      }

      // --- DNA double helix (procedural, slow twist; draws into dyn) ------
      // Entrance: the helix draws itself top-to-bottom over DNA_DRAW_MS,
      // starting at dnaStart (its slot in the reveal stagger); pass a
      // maxRow to limit how much of it exists yet.
      const DNA_DRAW_MS = 600;
      let dnaStart = 0;
      const dnaPalA = DNA.palA.map(hex2int);
      const dnaPalB = DNA.palB.map(hex2int);
      const dnaPairs = DNA.rungPairs.map((p) => ({
        a: { main: p.a.main.map(hex2int), tip: hex2int(p.a.tip) },
        b: { main: p.b.main.map(hex2int), tip: hex2int(p.b.tip) },
      }));
      let dnaPrev = new Map();
      function dnaColor(p, r) { return p[hashStr('dna' + r) % p.length]; }
      function renderDna(phase, maxRow) {
        const next = new Map();
        const cx = DNA.x + (DNA.w - 2) / 2;   // strands are 2 cells wide
        const amp = DNA.amp - 0.5;
        const put = (x, y, c) => {
          if (inGrid(x, y)) next.set(idxOf(x, y), c);
        };
        const rows = Math.min(DNA.h, maxRow);
        for (let r = 0; r < rows; r++) {
          const y = DNA.y + r;
          const t = r * (DNA.freq || 0.42) + phase;
          const sa = Math.sin(t), sb = Math.sin(t + Math.PI);
          const xa = Math.round(cx + amp * sa);
          const xb = Math.round(cx + amp * sb);
          // Base pairs: two coloured half-segments meeting at a 1-cell
          // gap, every 2nd row where there's room for half + gap + half.
          // Each rung is one of the two complementary pair types
          // (periwinkle–maroon or green–red, never mixed); which type
          // and which side each family sits on are stable per row. The
          // cell touching the gap takes the family's lighter tip shade.
          if (r % 2 === 1 && Math.abs(xa - xb) >= 5) {
            const lo = Math.min(xa, xb), hi = Math.max(xa, xb);
            // One hash per row: low bit picks the pair type, a higher bit
            // the orientation (the low bits of separate hashes correlate
            // across neighbouring row numbers).
            const pairHash = hashStr('pair' + r);
            const pair = dnaPairs[pairHash % dnaPairs.length];
            const flip = (pairHash >> 3) & 1;
            const [famL, famR] = flip ? [pair.b, pair.a] : [pair.a, pair.b];
            const x0 = lo + 2, x1 = hi - 1;      // interior span, touching each strand
            const gapX = x0 + ((x1 - x0) >> 1);  // the 1-cell gap between the bases
            for (let x = x0; x < gapX; x++)
              put(x, y, x === gapX - 1 ? famL.tip : dnaColor(famL.main, r * 31 + x));
            for (let x = gapX + 1; x <= x1; x++)
              put(x, y, x === gapX + 1 ? famR.tip : dnaColor(famR.main, r * 31 + x));
          }
          const strands = sa >= sb
            ? [[xb, dnaPalB], [xa, dnaPalA]]
            : [[xa, dnaPalA], [xb, dnaPalB]];
          for (const [sx, p] of strands) {
            put(sx, y, dnaColor(p, r));
            put(sx + 1, y, dnaColor(p, r * 7 + 3));
          }
        }
        for (const [i] of dnaPrev) {
          if (!next.has(i)) { dyn[i] = -1; dirty.add(i); }
        }
        for (const [i, c] of next) {
          if (dyn[i] !== c) { dyn[i] = c; dirty.add(i); }
        }
        dnaPrev = next;
      }

      // --- chart lines (redraw sweep inside the painted panel) -------------
      const CHART = CFG.chart;
      const chartColA = hex2int(CHART.colA), chartColB = hex2int(CHART.colB);
      const chartInner = { x: CHART.x + 1, y: CHART.y + 1, w: CHART.w - 2, h: CHART.h - 2 };
      let chartNext = null, chartDrawn = -1, chartCycleStart = 0;
      const CHART_DRAW_MS = 2000, CHART_HOLD_MS = 8000;
      function genSeries() {
        const wobble = (v, lo, hi, drift, noise) => {
          v += drift + (Math.random() - 0.5) * noise;
          return Math.max(lo, Math.min(hi, v));
        };
        const a = [], b = [];
        let va = chartInner.h - 2.5, vb = chartInner.h - 1.5;
        const driftA = -(chartInner.h - 4) / chartInner.w;
        for (let k = 0; k < chartInner.w; k++) {
          va = wobble(va, 0.5, chartInner.h - 1.5, driftA, 1.0);
          vb = wobble(vb, 1.0, chartInner.h - 1.0, driftA * 0.9, 2.6);
          a.push(Math.round(va));
          b.push(Math.round(vb));
        }
        a[chartInner.w - 1] = Math.min(a[chartInner.w - 1], 1);
        return { a, b };
      }
      function chartPlot(k, series, col) {
        const x = chartInner.x + k;
        const yv = chartInner.y + series[k];
        const prev = k > 0 ? chartInner.y + series[k - 1] : yv;
        const lo = Math.min(yv, prev), hi = Math.max(yv, prev);
        for (let y = lo; y <= hi; y++) {
          if (!inGrid(x, y)) continue;
          const i = idxOf(x, y);
          dyn[i] = col;
          dirty.add(i);
        }
      }
      function chartWipeCol(k) {
        const x = chartInner.x + k;
        for (let y = chartInner.y; y < chartInner.y + chartInner.h; y++) {
          if (!inGrid(x, y)) continue;
          const i = idxOf(x, y);
          if (dyn[i] >= 0) { dyn[i] = -1; dirty.add(i); }
        }
      }
      function chartTick() {
        if (!chartNext) { chartNext = genSeries(); chartCycleStart = vnow; chartDrawn = -1; }
        const el = vnow - chartCycleStart;
        if (el <= CHART_DRAW_MS) {
          const target = Math.min(chartInner.w - 1, Math.floor((el / CHART_DRAW_MS) * chartInner.w));
          for (let k = chartDrawn + 1; k <= target; k++) {
            chartWipeCol(k);
            chartPlot(k, chartNext.a, chartColA);
            chartPlot(k, chartNext.b, chartColB);
          }
          chartDrawn = Math.max(chartDrawn, target);
        } else if (el > CHART_DRAW_MS + CHART_HOLD_MS) {
          chartNext = genSeries();
          chartCycleStart = vnow;
          chartDrawn = -1;
        }
      }
      function chartDrawAll() {
        chartNext = genSeries();
        for (let k = 0; k < chartInner.w; k++) {
          chartWipeCol(k);
          chartPlot(k, chartNext.a, chartColA);
          chartPlot(k, chartNext.b, chartColB);
        }
      }

      // --- steam train crossing the painted viaduct -------------------------
      const TRAIN = CFG.train;
      const trainBody = TRAIN.body.map(hex2int);
      const trainCar = TRAIN.carriage.map(hex2int);
      const trainSteam = TRAIN.steam.map(hex2int);
      const TRAIN_SPEED = 4.0;           // cells per second
      const TRAIN_PAUSE_MS = 3000;       // rest between crossings
      // null = not started: the first tick backdates the clock so the nose
      // is already at the deck edge — the first sighting lands right when
      // the tick gate opens, instead of 6s later after the hidden lead-in.
      // (null, not a negative number: the backdated value is itself
      // negative early on, and must not trigger the backdate again.)
      let trainStart = null;
      let trainPrev = new Map();
      function trainCells(front) {
        const cellsOut = new Map();
        const rowTop = TRAIN.row, rowMid = TRAIN.row + 1, rowBot = TRAIN.row + 2;
        const put = (x, y, c) => {
          if (x >= TRAIN.x0 && x <= TRAIN.x1 && inGrid(x, y)) cellsOut.set(idxOf(x, y), c);
        };
        for (let k = 0; k < 7; k++) put(front - k, rowBot, trainBody[k % 2]);
        for (let k = 0; k < 7; k++) put(front - k, rowMid, trainBody[(k + 1) % 2]);
        put(front - 6, rowTop, trainBody[0]);
        put(front - 5, rowTop, trainBody[1]);
        put(front, rowTop, trainBody[0]);
        for (let k = 9; k <= 12; k++) {
          put(front - k, rowBot, trainCar[k % 2]);
          put(front - k, rowMid, trainCar[(k + 1) % 2]);
        }
        for (let k = 14; k <= 17; k++) {
          put(front - k, rowBot, trainCar[(k + 1) % 2]);
          put(front - k, rowMid, trainCar[k % 2]);
        }
        for (let k = 19; k <= 22; k++) {
          put(front - k, rowBot, trainCar[k % 2]);
          put(front - k, rowMid, trainCar[(k + 1) % 2]);
        }
        put(front, rowTop - 1, trainSteam[0]);
        put(front - 1, rowTop - 2, trainSteam[1]);
        put(front - 3, rowTop - 2, trainSteam[0]);
        put(front - 5, rowTop - 1, trainSteam[1]);
        return cellsOut;
      }
      function applyTrain(cellsIn) {
        for (const [i] of trainPrev) {
          if (!cellsIn.has(i)) { overlay[i] = -1; dirty.add(i); }
        }
        for (const [i, c] of cellsIn) {
          if (overlay[i] !== c) { overlay[i] = c; dirty.add(i); }
        }
        trainPrev = cellsIn;
      }
      function trainTick() {
        // lead-in/out sized to the full train length (front to third
        // carriage tail at front−22) so it enters and exits cleanly
        const span = (TRAIN.x1 - TRAIN.x0) + 48;
        const crossMs = (span / TRAIN_SPEED) * 1000;
        // First run: backdate the clock past the 24-cell lead-in so the
        // nose enters the deck immediately. Later cycles keep the full
        // lead-in, so repeat crossings ease in from off-stage as before.
        if (trainStart === null) trainStart = vnow - (24 / TRAIN_SPEED) * 1000;
        const el = vnow - trainStart;
        if (el > crossMs + TRAIN_PAUSE_MS) { trainStart = vnow; return; }
        if (el > crossMs) { if (trainPrev.size) applyTrain(new Map()); return; }
        const front = Math.round(TRAIN.x0 - 24 + (el / 1000) * TRAIN_SPEED);
        applyTrain(trainCells(front));
      }

      // --- confetti twinkle --------------------------------------------------
      const activeTwinkles = [];
      let nextTwinkle = 2500;
      function twinkleTick() {
        if (vnow >= nextTwinkle && twinklePool.length) {
          nextTwinkle = vnow + 700 + Math.random() * 1200;
          const i = twinklePool[(Math.random() * twinklePool.length) | 0];
          activeTwinkles.push({ i, t0: vnow });
        }
        for (let k = activeTwinkles.length - 1; k >= 0; k--) {
          const tw = activeTwinkles[k];
          const t = (vnow - tw.t0) / 650;
          if (t >= 1) {
            twinkles.delete(tw.i);
            activeTwinkles.splice(k, 1);
          } else {
            twinkles.set(tw.i, Math.sin(Math.PI * t) * 0.75);
          }
          dirty.add(tw.i);
        }
      }

      // --- flask bubbles (rise through the painted liquid) --------------------
      // The liquid is discovered from the artwork at boot: within the
      // configured region, each column's span of saturated red/maroon
      // cells is its liquid depth. Bubbles spawn near the bottom, drift
      // upward (with the odd sideways wobble into a neighbouring column),
      // and pop when they reach that column's surface.
      const BUB = CFG.bubbles;
      const bubPal = BUB ? BUB.pal.map(hex2int) : [];
      const bubCols = [];                   // {x, top, bot} per liquid column
      if (BUB) {
        const isLiquid = (v) => {
          if (v < 0) return false;
          const r = (v >> 16) & 255, g = (v >> 8) & 255, b = v & 255;
          return (r > 150 && g < 110 && b < 110) || (r > 60 && r < 160 && g < 60 && b < 70);
        };
        for (let x = BUB.x; x < BUB.x + BUB.w; x++) {
          let top = -1, bot = -1;
          for (let y = BUB.y; y < BUB.y + BUB.h; y++) {
            if (inGrid(x, y) && isLiquid(cells[idxOf(x, y)])) { if (top < 0) top = y; bot = y; }
          }
          if (top >= 0 && bot - top >= 2) bubCols.push({ x, top, bot });
        }
      }
      let bubbles = [];
      let wisps = [];                       // escaped vapour, rising up the neck
      let bubblePrev = new Map();
      const ESC = BUB && BUB.escape;
      const escPal = ESC ? ESC.pal.map(hex2int) : [];
      function bubbleTick() {
        if (!bubCols.length) return;
        while (bubbles.length < (BUB.count || 3)) {
          const col = bubCols[(Math.random() * bubCols.length) | 0];
          bubbles.push({
            x: col.x,
            y: col.bot - ((Math.random() * 2) | 0),
            col,
            colr: bubPal[(Math.random() * bubPal.length) | 0],
            next: vnow + 500 + Math.random() * 2200,   // staggered first move
          });
        }
        const next = new Map();
        for (let k = bubbles.length - 1; k >= 0; k--) {
          const b = bubbles[k];
          if (vnow >= b.next) {
            b.y -= 1;
            if (Math.random() < 0.25) {                // sideways wobble
              const nx = b.x + (Math.random() < 0.5 ? -1 : 1);
              const nc = bubCols.find((c) => c.x === nx);
              if (nc && b.y <= nc.bot && b.y > nc.top) { b.x = nx; b.col = nc; }
            }
            b.next = vnow + 260 + Math.random() * 260;
            if (b.y <= b.col.top) {                    // pop at the surface…
              if (ESC && wisps.length < 2 && Math.random() < ESC.chance) {
                wisps.push({                           // …and sometimes escape
                  x: b.x, y: b.col.top - 1,
                  colr: escPal[(Math.random() * escPal.length) | 0],
                  next: vnow + 300 + Math.random() * 300,
                });
              }
              bubbles.splice(k, 1);
              continue;
            }
          }
          next.set(idxOf(b.x, b.y), b.colr);
        }
        // vapour: funnel toward the neck centre while inside the flask,
        // wobble freely above the mouth, dissipate at topY
        for (let k = wisps.length - 1; k >= 0; k--) {
          const w = wisps[k];
          if (vnow >= w.next) {
            w.y -= 1;
            if (w.y > ESC.mouthY) {
              if (w.x !== ESC.x) w.x += w.x < ESC.x ? 1 : -1;
            } else if (Math.random() < 0.4) {
              w.x += Math.random() < 0.5 ? -1 : 1;
            }
            w.next = vnow + 380 + Math.random() * 320;
            if (w.y <= ESC.topY) { wisps.splice(k, 1); continue; }
          }
          if (inGrid(w.x, w.y)) next.set(idxOf(w.x, w.y), w.colr);
        }
        for (const [i] of bubblePrev) {
          if (!next.has(i)) { dyn[i] = -1; dirty.add(i); }
        }
        for (const [i, c] of next) {
          if (dyn[i] !== c) { dyn[i] = c; dirty.add(i); }
        }
        bubblePrev = next;
      }

      // --- skyscraper window lights ----------------------------------------
      // Buildings are discovered from the artwork: within the district,
      // each column's contiguous run of solid cells grounded on the
      // bottom row is a tower (art floating above is ignored). Windows
      // are interior lattice cells; a handful glow warm at any moment.
      const LIGHTS = CFG.lights;
      const lightsPal = LIGHTS ? LIGHTS.pal.map(hex2int) : [];
      const windows = [];
      // Painted gold windows (winTone cells inside a tower): permanently
      // lit in the artwork; the animation occasionally switches one off
      // by overlaying the tower's own body colour, then lets it relight.
      const paintedWins = [];              // {i, off}
      if (LIGHTS) {
        const solidCell = (x, y) => inGrid(x, y) && cells[idxOf(x, y)] >= 0 && !nearBg(cells[idxOf(x, y)]);
        const gy = LIGHTS.y + LIGHTS.h - 1;
        const runs = new Map();
        for (let x = LIGHTS.x; x < LIGHTS.x + LIGHTS.w; x++) {
          let bot = -1;
          for (let y = gy; y >= gy - 2; y--) if (solidCell(x, y)) { bot = y; break; }
          if (bot < 0) continue;
          let top = bot;
          while (top - 1 >= LIGHTS.y && solidCell(x, top - 1)) top--;
          if (bot - top >= 4) runs.set(x, { top, bot });
        }
        const winT = LIGHTS.winTone ? hex2int(LIGHTS.winTone) : -2;
        for (const [x, run] of runs) {
          const L = runs.get(x - 1), R = runs.get(x + 1);
          for (let y = run.top + 1; y < run.bot; y++) {
            if (!(L && y >= L.top && y <= L.bot && R && y >= R.top && y <= R.bot)) continue;
            if (x % 2 === 0 || y % 2 === 1) continue;   // sparse window lattice
            // Painted windows are handled by their own off/on cycle below.
            if (cells[idxOf(x, y)] === winT) continue;
            windows.push(idxOf(x, y));
          }
        }
        // Collect the painted windows, each with its "off" colour: the
        // most common non-warm solid tone among its neighbours — i.e.
        // the tower wall around it.
        const warmT = new Set([winT, ...lightsPal]);
        for (const [x, run] of runs) {
          for (let y = run.top; y <= run.bot; y++) {
            if (cells[idxOf(x, y)] !== winT) continue;
            const tally = new Map();
            for (let dy = -1; dy <= 1; dy++) {
              for (let dx = -1; dx <= 1; dx++) {
                if (!dx && !dy || !inGrid(x + dx, y + dy)) continue;
                const n = cells[idxOf(x + dx, y + dy)];
                if (n >= 0 && !nearBg(n) && !warmT.has(n)) tally.set(n, (tally.get(n) || 0) + 1);
              }
            }
            let off = -1, best = 0;
            for (const [c, k] of tally) if (k > best) { best = k; off = c; }
            if (off >= 0) paintedWins.push({ i: idxOf(x, y), off });
          }
        }
      }
      const lit = new Map();               // window idx → lights-out time
      const darkWins = new Map();          // painted-window idx → relight time
      let nextLight = 0;
      let nextDark = 0;
      function lightsTick() {
        if (!windows.length && !paintedWins.length) return;
        if (windows.length && vnow >= nextLight) {
          nextLight = vnow + 3000 + Math.random() * 1000;   // a new light every 3–4s
          if (lit.size < (LIGHTS.maxOn || 8)) {
            const i = windows[(Math.random() * windows.length) | 0];
            if (!lit.has(i) && dyn[i] < 0) {
              lit.set(i, vnow + 1500 + Math.random() * 4500);
              dyn[i] = lightsPal[(Math.random() * lightsPal.length) | 0];
              dirty.add(i);
            }
          }
        }
        for (const [i, until] of lit) {
          if (vnow >= until) { lit.delete(i); dyn[i] = -1; dirty.add(i); }
        }
        // Painted windows: the mirror image — same rhythm, but these
        // start lit (the artwork) and occasionally switch off, showing
        // the tower wall, before relighting.
        if (paintedWins.length && vnow >= nextDark) {
          nextDark = vnow + 3000 + Math.random() * 1000;
          const w = paintedWins[(Math.random() * paintedWins.length) | 0];
          if (!darkWins.has(w.i) && dyn[w.i] < 0) {
            darkWins.set(w.i, vnow + 1500 + Math.random() * 4500);
            dyn[w.i] = w.off;
            dirty.add(w.i);
          }
        }
        for (const [i, until] of darkWins) {
          if (vnow >= until) { darkWins.delete(i); dyn[i] = -1; dirty.add(i); }
        }
      }

      // --- lightbulb blink ---------------------------------------------------
      // The bulb, its filament cross and its rays are all painted art;
      // this overlay only ever hides or dims them, so repainting the bulb
      // Just Works. Discovery at boot: the glass bbox comes from the ring
      // tones, the cross is cross-toned cells inside it, and the rays are
      // ray-toned cells outside it within maxRay of the bulb's centre.
      const BULBC = CFG.bulb;
      const bulbRays = [];                 // {i, d} sorted nearest-first
      const bulbCross = [];
      let bulbOffTint = -1;
      if (BULBC) {
        const toneSet = (list) => new Set(list.map(hex2int));
        const glassT = toneSet(BULBC.glass), crossT = toneSet(BULBC.cross), rayT = toneSet(BULBC.rays);
        bulbOffTint = hex2int(BULBC.offCross);
        let gx0 = 1e9, gy0 = 1e9, gx1 = -1, gy1 = -1;
        const scan = (fn) => {
          for (let y = BULBC.y; y < BULBC.y + BULBC.h; y++)
            for (let x = BULBC.x; x < BULBC.x + BULBC.w; x++)
              if (inGrid(x, y)) fn(x, y, cells[idxOf(x, y)]);
        };
        scan((x, y, v) => {
          if (glassT.has(v)) {
            if (x < gx0) gx0 = x; if (x > gx1) gx1 = x;
            if (y < gy0) gy0 = y; if (y > gy1) gy1 = y;
          }
        });
        if (gx1 >= 0) {
          const cx = (gx0 + gx1) / 2, cy = (gy0 + gy1) / 2;
          scan((x, y, v) => {
            const inGlass = x >= gx0 && x <= gx1 && y >= gy0 && y <= gy1;
            if (inGlass && crossT.has(v)) bulbCross.push(idxOf(x, y));
            else if (!inGlass && rayT.has(v)) {
              const d = Math.hypot(x - cx, y - cy);
              if (d <= (BULBC.maxRay || 11)) bulbRays.push({ i: idxOf(x, y), d });
            }
          });
          bulbRays.sort((a, b) => a.d - b.d);
        }
      }
      let bulbPhase = 0;                   // 0 lit · 1 dark · 2 relighting
      let bulbNext = 0;                    // phase end (or relight start)
      function bulbSet(i, c) { if (dyn[i] !== c) { dyn[i] = c; dirty.add(i); } }
      function bulbTick() {
        if (!bulbRays.length) return;
        if (bulbNext === 0) bulbNext = vnow + BULBC.onMs + Math.random() * BULBC.onJitter;
        if (bulbPhase === 0 && vnow >= bulbNext) {
          // blink off: every ray vanishes at once, the cross dims to blue
          for (const r of bulbRays) bulbSet(r.i, BASE_TILE);
          for (const i of bulbCross) bulbSet(i, bulbOffTint);
          bulbPhase = 1;
          bulbNext = vnow + BULBC.offMs + Math.random() * BULBC.offJitter;
        } else if (bulbPhase === 1 && vnow >= bulbNext) {
          // relight: the cross snaps back beige, rays follow outward
          for (const i of bulbCross) bulbSet(i, -1);
          bulbPhase = 2;
          bulbNext = vnow;                 // relight sweep starts now
        } else if (bulbPhase === 2) {
          const frac = Math.min(1, (vnow - bulbNext) / (BULBC.relightMs || 500));
          const dMin = bulbRays[0].d, dMax = bulbRays[bulbRays.length - 1].d;
          const reach = dMin + (dMax - dMin) * frac;
          for (const r of bulbRays) { if (r.d <= reach) bulbSet(r.i, -1); }
          if (frac >= 1) {
            bulbPhase = 0;
            bulbNext = vnow + BULBC.onMs + Math.random() * BULBC.onJitter;
          }
        }
      }

      // --- petri dish: pipette drip + culture pulse --------------------------
      // Overlay-only, like the bulb: the painted dish is the resting
      // state. Discovery at boot — dish bbox from the rim tone, pipette
      // tip as the lowest red-family cell above the rim, red culture as
      // red-family cells inside the dish.
      const PETRI = CFG.petri;
      const petriColony = [];
      let petriSpawn = null;               // [x, y] where drops form
      let petriLand = 0;                   // row where a falling drop vanishes
      if (PETRI) {
        const rimT = new Set(PETRI.rim.map(hex2int));
        const colT = new Set(PETRI.colony.map(hex2int));
        let rx0 = 1e9, rx1 = -1, ry0 = 1e9;
        for (let y = PETRI.y; y < PETRI.y + PETRI.h; y++)
          for (let x = PETRI.x; x < PETRI.x + PETRI.w; x++)
            if (inGrid(x, y) && rimT.has(cells[idxOf(x, y)])) {
              if (x < rx0) rx0 = x; if (x > rx1) rx1 = x;
              if (y < ry0) ry0 = y;
            }
        if (rx1 >= 0) {
          petriLand = ry0 + (PETRI.dropDepth || 5);
          const tipXs = [];
          let tipY = -1;
          for (let y = PETRI.y; y < PETRI.y + PETRI.h; y++) {
            for (let x = rx0 + 1; x < rx1; x++) {
              if (!inGrid(x, y) || !colT.has(cells[idxOf(x, y)])) continue;
              if (y > ry0 + 2) petriColony.push(idxOf(x, y));
              else if (y > tipY) { tipY = y; tipXs.length = 0; tipXs.push(x); }
              else if (y === tipY) tipXs.push(x);
            }
          }
          if (tipY >= 0) {
            const tx = Math.round(tipXs.reduce((a, b) => a + b, 0) / tipXs.length);
            petriSpawn = [tx, tipY];
          }
        }
      }
      const petriDropPal = PETRI ? PETRI.dropPal.map(hex2int) : [];
      let petriPhase = 0;                  // 0 idle · 1 swell · 2 fall · 3 pulse
      let petriNext = 0;                   // current phase deadline
      let petriDropI = -1;                 // cell currently holding the drop
      let petriDropY = 0;
      function petriDropAt(y) {
        if (petriDropI >= 0) { dyn[petriDropI] = -1; dirty.add(petriDropI); petriDropI = -1; }
        if (y >= 0) {
          petriDropI = idxOf(petriSpawn[0], y);
          dyn[petriDropI] = petriDropPal[petriDropPal.length - 1];
          dirty.add(petriDropI);
        }
      }
      function petriTick() {
        if (!petriSpawn) return;
        if (petriNext === 0) petriNext = vnow + PETRI.idleMs + Math.random() * PETRI.idleJitter;
        if (petriPhase === 0 && vnow >= petriNext) {
          // a drop forms just under the tip, pale at first
          petriDropI = idxOf(petriSpawn[0], petriSpawn[1] + 1);
          dyn[petriDropI] = petriDropPal[0];
          dirty.add(petriDropI);
          petriPhase = 1;
          petriNext = vnow + (PETRI.swellMs || 500);
        } else if (petriPhase === 1 && vnow >= petriNext) {
          // saturated and heavy — let it fall
          petriDropY = petriSpawn[1] + 1;
          petriDropAt(petriDropY);
          petriPhase = 2;
          petriNext = vnow + (PETRI.stepMs || 100);
        } else if (petriPhase === 2 && vnow >= petriNext) {
          petriDropY += 1;
          if (petriDropY > petriLand) {
            // landed: the culture drinks it in — a brief warm pulse
            petriDropAt(-1);
            for (const i of petriColony) { dyn[i] = mix(cells[i], WHITE, 0.35); dirty.add(i); }
            petriPhase = 3;
            petriNext = vnow + (PETRI.pulseMs || 600);
          } else {
            petriDropAt(petriDropY);
            petriNext = vnow + (PETRI.stepMs || 100);
          }
        } else if (petriPhase === 3 && vnow >= petriNext) {
          for (const i of petriColony) { dyn[i] = -1; dirty.add(i); }
          petriPhase = 0;
          petriNext = vnow + PETRI.idleMs + Math.random() * PETRI.idleJitter;
        }
      }

      // --- pointer helpers -------------------------------------------------------
      function cellFromEvent(ev) {
        const r = canvas.getBoundingClientRect();
        const x = Math.floor((ev.clientX - r.left) / pw);
        const y = Math.floor((ev.clientY - r.top) / ph);
        return inGrid(x, y) ? [x, y] : null;
      }
      function figureAt(i) {
        const cid = compId[i];
        if (cid < 0) return null;
        const c = comps[cid];
        return c.size >= FIGURE_MIN ? c : null;
      }
      canvas.addEventListener('pointermove', (ev) => {
        const c = cellFromEvent(ev);
        if (!c) return;
        const i = idxOf(c[0], c[1]);
        canvas.style.cursor = (shown[i] && figureAt(i)) ? 'pointer' : 'default';
      });

      // --- click: scatter a figure, then it floods back in ----------------------
      function scatter(comp, seedIdx) {
        if (comp.busy || reduced) return;
        comp.busy = true;
        const list = [];
        for (const i of comp.cells) list.push({ t: vnow + rng() * 300, i, kind: 2 });
        const sx = seedIdx % COLS, sy = (seedIdx / COLS) | 0;
        const flood = floodOrder(comp.cells, sx, sy, 2.5);
        flood.forEach((i, r) => list.push({ t: vnow + 550 + (r / flood.length) * 750, i, kind: 1 }));
        pushEvents(list);
        setTimeout(() => { comp.busy = false; }, 1600);
      }
      canvas.addEventListener('click', (ev) => {
        const c = cellFromEvent(ev);
        if (!c) return;
        const i = idxOf(c[0], c[1]);
        if (!shown[i]) return;
        const comp = figureAt(i);
        if (comp) scatter(comp, i);
      });

      // --- main loop ---------------------------------------------------------------
      let rafId = 0;
      function advance(dt) {
        vnow += dt;
        processEvents();
        if (!reduced) {
          const dnaRows = vnow <= dnaStart ? 0 : Math.ceil(((vnow - dnaStart) / DNA_DRAW_MS) * DNA.h);
          renderDna(vnow * 0.00035, dnaRows);
          if (vnow > revealDone + 400) chartTick();
          if (vnow > revealDone + 500) trainTick();
          if (vnow > revealDone) { twinkleTick(); bubbleTick(); lightsTick(); bulbTick(); petriTick(); }
        }
        if (dirty.size) {
          for (const i of dirty) paint(i);
          dirty.clear();
        }
      }
      function frame(ts) {
        rafId = requestAnimationFrame(frame);
        if (lastTs < 0) lastTs = ts;
        const dt = Math.min(100, ts - lastTs);
        lastTs = ts;
        advance(dt);
      }

      function applyReduced() {
        showEverything();
        renderDna(0, DNA.h);
        chartDrawAll();
        applyTrain(trainCells(TRAIN.x0 + Math.round((TRAIN.x1 - TRAIN.x0) * 0.55)));
        for (const tw of activeTwinkles) twinkles.delete(tw.i);
        activeTwinkles.length = 0;
        for (const [i] of bubblePrev) dyn[i] = -1;   // still the liquid, no bubbles
        bubblePrev = new Map();
        bubbles = [];
        wisps = [];
        for (const [i] of lit) dyn[i] = -1;
        lit.clear();
        for (const [i] of darkWins) dyn[i] = -1;
        darkWins.clear();
        // Bulb rests in its painted "on" state: rays visible, cross beige.
        for (const r of bulbRays) dyn[r.i] = -1;
        for (const i of bulbCross) dyn[i] = -1;
        bulbPhase = 0;
        bulbNext = 0;
        // Petri dish rests as painted: no drop mid-air, culture unpulsed.
        if (petriDropI >= 0) { dyn[petriDropI] = -1; petriDropI = -1; }
        for (const i of petriColony) dyn[i] = -1;
        petriPhase = 0;
        petriNext = 0;
        repaintAll();
      }

      let inited = false;
      function boot() {
        if (inited) return;
        if (!layout()) return;   // stage hidden (mobile) — retry on resize
        inited = true;
        if (reduced) {
          applyReduced();
        } else {
          buildReveal();
          // Paint the instantly-shown calm field explicitly (previously it
          // appeared only via the ResizeObserver's initial repaint).
          repaintAll();
        }
        rafId = requestAnimationFrame(frame);
        if (window.ResizeObserver) new ResizeObserver(() => { if (pw) layout(); }).observe(stage);
      }
      boot();
      window.addEventListener('resize', boot);

      reduceMotion.addEventListener('change', () => {
        reduced = reduceMotion.matches;
        if (inited && reduced) applyReduced();
      });

      // Console access for tinkering / testing.
      window.SW_SPLASH = {
        config: CFG, comps, figures, layout, advance,
        trainAt: (x) => { applyTrain(trainCells(x)); for (const i of dirty) paint(i); dirty.clear(); },
        finish: () => { applyReduced(); },
      };
    })();

    // ----- Mobile hero: 6 pixel-art blocks (same art as desktop) + swap anim --
    (function () {
      const host = document.querySelector('.mobile-hero');
      if (!host || !window.SW) return;
      const PAL = window.SW.ART_PALETTE;
      const TOTAL = 132, N = 6;

      const blocks = [];
      for (let b = 0; b < N; b++) {
        const el = document.createElement('div');
        el.className = 'mhero-block';
        const cells = [];
        for (let i = 0; i < TOTAL; i++) {
          const cell = document.createElement('div');
          cell.className = 'mhero-cell';
          el.appendChild(cell);
          cells.push(cell);
        }
        host.appendChild(el);
        blocks.push(cells);
      }

      // Per-block live cell data (palette indices), seeded from the art.
      const slotData = Array.from({ length: N }, () => new Array(TOTAL).fill(0));

      function render(art) {
        const grids = (art && art.grids) || [];
        for (let b = 0; b < N; b++) {
          const src = grids[b] || [];
          for (let i = 0; i < TOTAL; i++) {
            slotData[b][i] = src[i] || 0;
            blocks[b][i].style.background = PAL[slotData[b][i]] || PAL[0];
          }
        }
      }

      // ----- Swap animation --------------------------------------------------
      // Block layout (text fills cols 2-3 of rows 2-4):  0 1 2 / 3 / 4 / 5.
      // Fixed pairs per the diagram (1 2 1 / 3 / 2 / 3).
      const FIXED_PAIRS = [[0, 2], [1, 4], [3, 5]];
      const DISSOLVE_MS = 12000;       // each swap dissolves over 12s
      const PAUSE_MS = 7500;           // pause after a swap before it loops
      const SWAP_INTERVAL_MS = DISSOLVE_MS + PAUSE_MS;   // 19.5s loop period per pair
      const PAIR_OFFSETS_MS = [0, 1500, 7500];           // each pair's start offset from load

      let animGen = 0, intervals = [];
      function stop() { animGen++; intervals.forEach(clearInterval); intervals = []; }

      function dissolveSwap(a, b, gen) {
        const order = new Array(TOTAL);
        for (let i = 0; i < TOTAL; i++) order[i] = i;
        for (let k = TOTAL - 1; k > 0; k--) {          // shuffle → cells flip in random order
          const j = (Math.random() * (k + 1)) | 0;
          const t = order[k]; order[k] = order[j]; order[j] = t;
        }
        // One rAF loop: batch all cells due this frame → one repaint per frame.
        let cursor = 0, start = 0;
        function frame(now) {
          if (gen !== animGen) return;
          if (!start) start = now;
          const targetCount = Math.min(TOTAL, Math.floor(((now - start) / DISSOLVE_MS) * TOTAL));
          for (; cursor < targetCount; cursor++) {
            const i = order[cursor];
            const tmp = slotData[a][i];
            slotData[a][i] = slotData[b][i];
            slotData[b][i] = tmp;
            blocks[a][i].style.background = PAL[slotData[a][i]] || PAL[0];
            blocks[b][i].style.background = PAL[slotData[b][i]] || PAL[0];
          }
          if (cursor < TOTAL) requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      }

      function start() {
        stop();
        const gen = animGen;
        FIXED_PAIRS.forEach((pair, idx) => {
          setTimeout(() => {
            if (gen !== animGen) return;
            dissolveSwap(pair[0], pair[1], gen);
            const id = setInterval(() => {
              if (gen !== animGen) { clearInterval(id); return; }
              dissolveSwap(pair[0], pair[1], gen);
            }, SWAP_INTERVAL_MS);
            intervals.push(id);
          }, PAIR_OFFSETS_MS[idx] || 0);
        });
      }

      // Only animate when the mobile hero is visible; respect reduced-motion.
      const mqMobile = window.matchMedia('(max-width: 600px)');
      const mqMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      // Animate only when visible, on a mobile viewport, and motion is allowed —
      // the visibility check stops the backgrounded-tab "catch-up" burst.
      function sync() { (!document.hidden && mqMobile.matches && !mqMotion.matches) ? start() : stop(); }
      mqMobile.addEventListener('change', sync);
      mqMotion.addEventListener('change', sync);
      document.addEventListener('visibilitychange', sync);

      window.SW.loadArt().then((art) => { render(art); sync(); });
    })();

    // ----- Spotlight cards: fill each right panel with a whole-cell dot grid -
    (function () {
      const panels = document.querySelectorAll('.project-img-cells, .infocus-pix, .report-card-pix');
      if (!panels.length) return;

      function fill(el) {
        const cs = getComputedStyle(el);
        const cols = parseInt(cs.getPropertyValue('--card-pix-cols'), 10) || 11;
        const cell = parseFloat(cs.getPropertyValue('--card-pix-cell')) || 10;
        const gap  = parseFloat(cs.getPropertyValue('--card-pix-gap'))  || 3;
        const fixedRows = parseInt(cs.getPropertyValue('--card-pix-rows'), 10);
        // Fixed row count if declared; otherwise fit whole rows to the height
        // (last partial cell dropped, never sliced).
        const rows = fixedRows > 0
          ? fixedRows
          : Math.max(0, Math.floor((el.clientHeight + gap) / (cell + gap)));
        const need = rows * cols;
        let have = el.childElementCount;
        if (have === need) return;
        while (el.childElementCount > need) el.removeChild(el.lastChild);
        if (have < need) {
          const frag = document.createDocumentFragment();
          for (let i = have; i < need; i++) {
            const c = document.createElement('div');
            c.className = 'pix-cell';
            frag.appendChild(c);
          }
          el.appendChild(frag);
        }
      }

      // Re-fill whenever a panel's height changes (font load, reflow, resize).
      const ro = new ResizeObserver(function (entries) {
        for (const e of entries) fill(e.target);
      });
      panels.forEach(function (el) { fill(el); ro.observe(el); });
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(function () { panels.forEach(fill); });
      }
    })();

    // ----- Latest reports carousel: arrow controls + drag-to-scroll ------
    (function () {
      const track = document.querySelector('.carousel-track');
      if (!track) return;
      const prev = document.querySelector('.carousel-arrow[data-dir="-1"]');
      const next = document.querySelector('.carousel-arrow[data-dir="1"]');

      function stepWidth() {
        const card = track.querySelector('.report-card');
        return card ? card.getBoundingClientRect().width + 20 : 320;
      }
      function updateArrows() {
        // Tolerance band: scroll-snap + the track's 2px padding leave "home" a
        // few px off 0 (and likewise at the far end), so an exact test misses.
        // 8px is comfortably under a card width, so it never misfires mid-scroll.
        const EDGE = 8;
        const max = track.scrollWidth - track.clientWidth;
        if (prev) prev.disabled = track.scrollLeft <= EDGE;
        if (next) next.disabled = track.scrollLeft >= max - EDGE;
      }
      if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -stepWidth(), behavior: 'smooth' }); });
      if (next) next.addEventListener('click', function () { track.scrollBy({ left: stepWidth(), behavior: 'smooth' }); });
      track.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows);
      window.addEventListener('load', updateArrows);
      // Re-check once card images load and reflow the track width.
      if (window.ResizeObserver) new ResizeObserver(updateArrows).observe(track);
      updateArrows();

      // Drag / swipe to scroll.
      let down = false, startX = 0, startLeft = 0, moved = false;
      track.addEventListener('pointerdown', function (e) {
        if (e.pointerType !== 'mouse') return;   // touch/pen use native scroll (no manual drag)
        down = true; moved = false;
        startX = e.clientX; startLeft = track.scrollLeft;
      });
      track.addEventListener('pointermove', function (e) {
        if (!down) return;
        const dx = e.clientX - startX;
        // Only start a real drag — and capture the pointer — once we cross the
        // threshold. Capturing on pointerdown would retarget the trailing click
        // to the track, so a plain click never reached the card's <a> overlay.
        if (!moved && Math.abs(dx) > 4) {
          moved = true;
          track.classList.add('dragging');
          track.setPointerCapture(e.pointerId);
        }
        if (moved) track.scrollLeft = startLeft - dx;
      });
      function release() { down = false; track.classList.remove('dragging'); }
      track.addEventListener('pointerup', release);
      track.addEventListener('pointercancel', release);
      // Suppress the click that follows a drag so cards don't navigate.
      track.addEventListener('click', function (e) {
        if (moved) { e.preventDefault(); e.stopPropagation(); }
      }, true);
    })();

    // ----- Intro matrix: colour the 7x2 decorative grid from a motif ----
    (function () {
      const grid = document.querySelector('.intro-matrix');
      if (!grid) return;
      const MOTIF = '1335513' + '5122403';   // 7 cols x 2 rows, row-major
      const COLOURS = {
        '0': 'var(--almost-white)',
        '1': 'var(--beige)',
        '2': 'var(--bright-blue)',
        '3': 'var(--theme)',
        '4': 'var(--pale-blue)',
        '5': 'var(--coral)',
      };
      const spans = grid.children;
      const base = [];
      for (let i = 0; i < spans.length; i++) {
        const c = (i < MOTIF.length && COLOURS[MOTIF[i]]) || 'var(--border-grey)';
        spans[i].style.background = c;
        base[i] = c;
      }

      // Gentle, occasional life: one cell at a time mostly goes hollow or
      // transparent for a moment; rarely one changes colour. CSS transitions
      // smooth every change. Pauses when hidden; off under reduced-motion.
      const mqMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const PALETTE = ['var(--beige)', 'var(--bright-blue)', 'var(--theme)', 'var(--pale-blue)', 'var(--coral)', 'var(--sage)'];
      const rand = function (a, b) { return a + Math.random() * (b - a); };
      let calmTimer = 0, active = false;

      function revert(i) {
        spans[i].style.background = base[i];
        spans[i].style.boxShadow = 'inset 0 0 0 0 transparent';
      }
      function applyEffect(i) {
        const r = Math.random();
        if (r < 0.45) {                 // hollow ring
          spans[i].style.background = 'transparent';
          spans[i].style.boxShadow = 'inset 0 0 0 2px ' + base[i];
        } else if (r < 0.85) {          // briefly transparent
          spans[i].style.background = 'transparent';
        } else {                        // rare colour change
          spans[i].style.background = PALETTE[(Math.random() * PALETTE.length) | 0];
        }
      }
      function act() {
        const i = (Math.random() * spans.length) | 0;
        applyEffect(i);
        setTimeout(function () { revert(i); }, rand(1400, 3000));
        schedule();
      }
      function schedule() {
        clearTimeout(calmTimer);
        calmTimer = setTimeout(act, rand(2600, 6500));
      }
      function start() { if (!active) { active = true; schedule(); } }
      function stop() {
        active = false;
        clearTimeout(calmTimer);
        for (let i = 0; i < spans.length; i++) revert(i);
      }
      function sync() { (!document.hidden && !mqMotion.matches) ? start() : stop(); }

      mqMotion.addEventListener('change', sync);
      document.addEventListener('visibilitychange', sync);
      sync();
    })();
</script>

<script is:inline>
    // Subtle falling pixel "rain" in the empty band to the right of the project
    // cards. Desktop only; respects reduced-motion; pauses when hidden/off-screen.
    (function () {
      const canvas = document.querySelector('.spotlight-rain');
      if (!canvas || !canvas.getContext) return;
      const ctx = canvas.getContext('2d');

      // Muted theme colours, rendered at low alpha so the effect stays quiet.
      const css = getComputedStyle(document.documentElement);
      const palette = ['--pale-blue', '--sage', '--border-grey', '--deep-green', '--theme']
        .map(function (v) { return css.getPropertyValue(v).trim(); })
        .filter(Boolean);
      const SIZES = [4, 5, 6, 7], RADIUS = 0.5;   // one spread for ALL drops; RADIUS 0 = perfectly square

      let W = 0, H = 0, drops = [], raf = 0, running = false, onScreen = true;
      const rand = function (a, b) { return a + Math.random() * (b - a); };

      function makeDrop(fromTop) {
        const hollow = Math.random() < 0.4;                     // ~40% are outlines, like the SIF cells
        const pick = function () { return SIZES[(Math.random() * SIZES.length) | 0]; };
        const size = hollow ? Math.max(pick(), pick())          // outlines skew larger so they still read
                            : pick();
        const amp = rand(1.5, 4);   // sway amplitude — inset x by it so drops stay in-band
        return {
          x: rand(amp, Math.max(amp + 1, W - size - amp)),
          y: fromTop ? -size : rand(0, H),
          size: size,
          speed: rand(0.12, 0.45),        // slow = rain-like and subtle
          alpha: Math.random() < 0.6 ? 1 : rand(0.5, 1),   // mostly full, never below 0.5
          color: palette[(Math.random() * palette.length) | 0] || '#888',
          hollow: hollow,
          // Smoothed sideways drift: small sine sway tied to vertical position.
          amp: amp,
          freq: rand(0.010, 0.024),
          phase: rand(0, Math.PI * 2),
        };
      }
      function build() {
        const n = Math.max(6, Math.min(26, Math.round(H / 48)));
        drops = [];
        for (let i = 0; i < n; i++) drops.push(makeDrop(false));
      }
      // Height runs from the top of the column down to the top of card 3.
      function targetHeight() {
        const main = canvas.parentElement;
        const cards = main ? main.querySelectorAll('.project') : [];
        if (cards.length >= 3 && cards[2].offsetTop > 0) return cards[2].offsetTop;
        return main ? main.clientHeight : (canvas.clientHeight || 1);
      }
      function resize() {
        canvas.style.height = targetHeight() + 'px';
        const r = canvas.getBoundingClientRect();
        W = Math.max(1, r.width);
        H = Math.max(1, r.height);
        const dpr = window.devicePixelRatio || 1;
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        build();
      }
      function roundRect(x, y, w, h, r) {
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y, x + w, y, r);
        ctx.closePath();
      }
      function draw() {
        ctx.clearRect(0, 0, W, H);
        for (let i = 0; i < drops.length; i++) {
          const d = drops[i];
          ctx.globalAlpha = d.alpha;
          const sway = Math.sin(d.y * d.freq + d.phase) * d.amp;
          if (d.hollow) {
            roundRect(d.x + sway, d.y, d.size, d.size, RADIUS);
            ctx.lineWidth = 2;
            ctx.strokeStyle = d.color;
            ctx.stroke();
          } else {
            roundRect(d.x + sway, d.y, d.size, d.size, RADIUS);
            ctx.fillStyle = d.color;
            ctx.fill();
          }
        }
        ctx.globalAlpha = 1;
      }
      function tick() {
        for (let i = 0; i < drops.length; i++) {
          const d = drops[i];
          d.y += d.speed;
          if (d.y > H + d.size) drops[i] = makeDrop(true);
        }
        draw();
        raf = requestAnimationFrame(tick);
      }
      function start() {
        if (running) return;
        running = true;
        if (!W || !H) resize();
        raf = requestAnimationFrame(tick);
      }
      function stop() {
        running = false;
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
      }

      const mqDesktop = window.matchMedia('(min-width: 901px)');
      const mqMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      function sync() {
        (!document.hidden && onScreen && mqDesktop.matches && !mqMotion.matches) ? start() : stop();
      }

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          onScreen = entries[0].isIntersecting;
          sync();
        }, { threshold: 0 }).observe(canvas);
      }
      window.addEventListener('resize', function () { if (mqDesktop.matches) resize(); });
      mqDesktop.addEventListener('change', sync);
      mqMotion.addEventListener('change', sync);
      document.addEventListener('visibilitychange', sync);

      if (mqDesktop.matches) resize();
      sync();
      // Card heights can shift once webfonts load — re-measure the target height.
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(function () { if (mqDesktop.matches) resize(); });
      }
    })();
</script>
</BaseLayout>
