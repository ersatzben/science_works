        border: 1.5px solid var(--theme);
        border-radius: 5px;
        padding: 5px 0px;
        white-space: nowrap;
  
      }
      .mhero-btn--primary { background: var(--theme); color: #fff; }
      .mhero-btn--secondary { background: #fff; color: var(--theme); }

      /* ----- rest of the homepage, reformatted for phones ----- */
      .content-wrap { padding: 0; }
      .content-wrap-lower { padding: 0; }
  
      .section-label { font-size: 22px; margin-bottom: 16px; display: flex; align-items: baseline; padding-right: 24px; }
      .scroll-cue { display: inline-flex; margin-left: auto; transform: translateY(-3px); }   /* push right; nudge up off the baseline */

      .spotlight {
