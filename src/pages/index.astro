        /* background-color: var(--almost-white);  */
      }
      /* Mobile cards are content-height (not the desktop 315px). Fixed-width
         8-column strip; the leftmost-8 art is top-anchored and fills from the top. */
      .project-img { --card-pix-cols: 8; width: 64px; }
      .project-img-art--wide { display: none !important; }
