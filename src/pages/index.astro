        margin: 0 0 10px 16px;            /* gap below + left of the wrapping text */
      }
      .intro-pic-cell { width: 100%; height: 100%; border-radius: 0.5px; }

      .spotlight-intro h2 {
        font-size: 20px;
        letter-spacing: 0.02em;
        color: var(--text);
        margin: 0 0 14px;
      }

      .spotlight-intro p { font-size: 14px; }

      .spotlight-intro-footer { margin-top: 20px; }

      /* Projects become a horizontal, swipeable carousel on mobile. */
      .spotlight-main { min-width: 0; background-color: var(--bg); padding: 30px 0 20px 24px; margin-top: 20px; }   /* let the grid item shrink so the carousel can overflow-scroll instead of stretching the column */
      .projects {
        flex-direction: row;
        gap: 14px;
        padding: 2px 0 14px;            /* content-wrap already insets 18px each side */
        overflow-x: auto;
