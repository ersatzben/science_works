  <script define:vars={{ MG_PAL: PALETTE.map((p) => p.hex) }}>
    // Mosaic-gallery browser: repaints the server-rendered 20×20 grid from the
    // embedded JSON list (same base-36 code format as the contact-page maker).
    (function () {
      var canvas = document.getElementById('mg-canvas');
      var dataEl = document.getElementById('mg-data');
      if (!canvas || !dataEl) return;
      var gallery = [];
      try { gallery = JSON.parse(dataEl.textContent) || []; } catch (_) {}
      if (gallery.length < 2) {   // nothing to browse — hide the arrows
        document.querySelectorAll('.mg-arrow').forEach(function (b) { b.style.visibility = 'hidden'; });
        return;
      }
      var PAL = MG_PAL;
      var cells = Array.prototype.slice.call(canvas.children);
      var idx = 0;
      function show(i) {
        idx = (i % gallery.length + gallery.length) % gallery.length;   // wrap both ways
        var g = gallery[idx];
        for (var k = 0; k < cells.length; k++) {
          var v = parseInt(g.code[k], 36);
          cells[k].style.background = (!isNaN(v) && PAL[v]) ? PAL[v] : PAL[0];
        }
      }
      document.getElementById('mg-prev').addEventListener('click', function () { show(idx - 1); });
      document.getElementById('mg-next').addEventListener('click', function () { show(idx + 1); });
      // Coin-flip the opening mosaic between two named favourites. The first
      // starter is the server-rendered file, so landing on it needs no repaint.
      var STARTERS = ['Claire Halpin', 'Jack Dalton'];
      var startIdx = gallery.findIndex(function (g) { return g.name === STARTERS[Math.random() < 0.5 ? 0 : 1]; });
      if (startIdx > 0) show(startIdx);
    })();
  </script>

