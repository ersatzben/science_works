      --card-pix-cell: var(--cell-size);     /* hero grid size (14px) */
      --card-pix-gap: var(--cell-gap);       /* hero grid spacing (2px) */
      --card-pix-radius: var(--cell-radius); /* hero grid radius (2px) */
      --card-pix-color: var(--border-grey);
      width: calc(var(--card-pix-cols) * var(--card-pix-cell)
                  + (var(--card-pix-cols) - 1) * var(--card-pix-gap));
      display: grid;
      grid-template-columns: repeat(var(--card-pix-cols), var(--card-pix-cell));
      grid-auto-rows: var(--card-pix-cell);
      gap: var(--card-pix-gap);
      overflow: hidden;
    }
    /* Grid-art cover: occupies the same left slot as the dot grid it replaces. */
    .infocus-art { position: relative; flex: 0 0 360px; align-self: stretch; margin: 20px; overflow: hidden; }
    /* The cover SVG is sized (height = card height) by JS. Positioning it
       absolutely keeps that JS-set height from feeding back into the card
       height — otherwise the card ratchets taller and can't contract again.
       JS still sets width/height/margin; left/right:0 + margin auto centres it. */
    .infocus-art svg { display: block; position: absolute; top: 0; left: 0; right: 0; }
    .infocus-meta {
      flex: 1;
      min-width: 0;
      padding: 24px 36px 24px 4px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;     /* top-align the text… */
    }
    .infocus-tag {
      font-family: 'Roboto', sans-serif;
      font-weight: bold;
      font-size: 13px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
